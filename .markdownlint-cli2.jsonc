{
  // markdownlint's default rules, with lines up to 100 characters. Tables and code blocks are
  // exempt from the line limit because their lines cannot be wrapped.
  "config": {
    "default": true,
    "MD013": { "line_length": 100, "tables": false, "code_blocks": false }
  },
  "globs": ["**/*.md"],
  // Skip everything .gitignore lists: dependencies, builds and Claude session state.
  "gitignore": true
}
